                              onChange={(tid) => updateTacticRow(slot, side, activeRt, idx, 'tactic_id', tid)}
                              options={opts} />
                            {/* 编号自动生成显示 */}
                            <span className={`text-[10px] font-mono flex-shrink-0 px-1.5 py-0.5 rounded border
