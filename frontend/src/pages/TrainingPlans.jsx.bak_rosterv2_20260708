                            </span>
                            {/* 教练补充说明 */}
                            <input value={row.instruction || ''}
                              onChange={e => updateTacticRow(slot, side, activeRt, idx, 'instruction', e.target.value)}
                              placeholder="补充说明..."
                              className="bg-ur-bg border border-ur-border rounded px-2 py-1 text-xs text-gray-300 outline-none focus:border-ur-accent/40 placeholder:text-gray-700"
                              style={{ width: 120 }} />
                            {/* 删除 */}
                            {canEdit && (
                              <button onClick={() => removeTacticRow(slot, side, activeRt, idx)}
                                className="text-gray-600 hover:text-ur-rose text-base leading-none transition-colors flex-shrink-0">×</button>
                            )}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                );
              })}
                  </div>
                );
              })}
            </div>
          );
        })}
      </div>

      {/* ── 保存/发布按钮 ── */}
      {canEdit && (
        <div className="flex justify-end gap-3 mb-6">
          <button onClick={() => save(false)} disabled={saving}
            className="px-5 py-2 rounded-lg border border-ur-border text-gray-300 text-sm hover:text-white hover:border-gray-500 disabled:opacity-50 transition-colors">
            {saving ? '保存中...' : '保存草稿'}
          </button>
          <button onClick={() => save(true)} disabled={saving}
            className="px-5 py-2 rounded-lg bg-ur-accent/15 border border-ur-accent/30 text-ur-accent text-sm font-semibold hover:bg-ur-accent/25 disabled:opacity-50 transition-colors">
            {saving ? '发布中...' : '发布简报'}
          </button>
        </div>
      )}

      {/* ── 历史简报记录 ── */}
      {history.length > 0 && (
        <div className="data-card">
          <h3 className="font-sans font-semibold text-white mb-4">历史简报</h3>
          <div className="space-y-1.5">
            {history.map(h => (
              <div key={h.id}
                onClick={() => setDate(h.brief_date)}
                className={`flex flex-wrap items-center gap-x-4 gap-y-1 px-3 py-2.5 rounded-lg border cursor-pointer transition-all
                  ${h.brief_date === date
                    ? 'border-ur-accent/40 bg-ur-accent/8'
                    : 'border-white/[0.05] bg-white/[0.02] hover:border-gray-500'}`}>
                <span className="font-mono text-xs text-gray-400 w-24">{h.brief_date}</span>
                <span className="text-sm font-semibold text-white flex-1 min-w-[100px]">vs {h.opponent || '—'}</span>
                <span className="text-xs text-gray-500">{h.map1_name || '?'} / {h.map2_name || '?'}</span>
                <span className="text-xs font-mono text-ur-accent">{h.tactics_count} 战术</span>
                {h.published === 1
                  ? <span className="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400">已发布</span>
                  : <span className="text-[10px] px-2 py-0.5 rounded-full bg-yellow-500/15 border border-yellow-500/30 text-yellow-400">草稿</span>}
                {canEdit && (
                  <button onClick={(e) => deleteBriefing(e, h.brief_date)}
                    className="text-gray-600 hover:text-ur-rose text-xs transition-colors px-1">删除</button>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

// ════════════════════════════════════════════════════════════
// 训练日志
// ════════════════════════════════════════════════════════════
function LogTab({ canEdit }) {
  const today = new Date().toISOString().split('T')[0];
  const [logs, setLogs] = useState([]);
  const [activeLog, setActiveLog] = useState(null);
  const [logDetail, setLogDetail] = useState(null);
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [newLogModal, setNewLogModal] = useState(false);
  const [editLogModal, setEditLogModal] = useState(null); // 待编辑的 log 对象
  const [logSearch, setLogSearch] = useState('');
  const [allTactics, setAllTactics] = useState([]);
  const [errorTypes, setErrorTypes] = useState([]);
  const [roster, setRoster] = useState([]);   // 动态服役队员名单（替代硬编码 PLAYERS，排除下放）
  const user = JSON.parse(localStorage.getItem('user') || '{}');
  const isCoach = user.role === 'coach';
  const isTeamLead = user.role === 'team_lead';
  const isAdmin = ['admin', 'coach', 'team_lead'].includes(user.role);
  const [fdCauses, setFdCauses] = useState(() => {
    try {
      const saved = localStorage.getItem('fd_causes_custom');
      const custom = saved ? JSON.parse(saved) : [];
      return [...FD_CAUSES, ...custom.filter(c => !FD_CAUSES.includes(c))];
    } catch { return [...FD_CAUSES]; }
  });
  const addFdCause = (cause) => {
    if (!cause || !cause.trim()) return;
    const trimmed = cause.trim();
    setFdCauses(prev => {
      if (prev.includes(trimmed)) return prev;
      const updated = [...prev, trimmed];
      const custom = updated.filter(c => !FD_CAUSES.includes(c));
      localStorage.setItem('fd_causes_custom', JSON.stringify(custom));
      return updated;
    });
  };

  // ── 多人并发录入支持 ──────────────────────────────
  const [syncState, setSyncState] = useState('idle'); // idle | dirty | saving | saved | error
  const dirtyRef = useRef(new Set());      // 本人改过、尚未保存的回合 id
  const [activeMapTab, setActiveMapTab] = useState(null); // r65 地图切换
  const detailRef = useRef(null);          // 最新 logDetail(供定时器读取)
  const saveTimerRef = useRef(null);
  const activeLogRef = useRef(null);
  useEffect(() => { detailRef.current = logDetail; }, [logDetail]);
  useEffect(() => { activeLogRef.current = activeLog; }, [activeLog]);

  useEffect(() => {
    loadLogs();
    api.get('/training-plans/tactics').then(r => setAllTactics(r.data)).catch(() => {});
    api.get('/training-plans/error-types?active=1').then(r => setErrorTypes(r.data)).catch(() => {});
    api.get('/players').then(({ data }) => {
      const list = (data || [])
        .filter(pl => pl.team_type === 'roster' && pl.roster_status !== 'demoted' && pl.status !== 'left')
        .sort((x, y) => (x.sort_order ?? 999) - (y.sort_order ?? 999) || x.id - y.id)
        .map(pl => pl.nickname);
      setRoster(list);
    }).catch(() => {});
  }, []);

  const loadLogs = async () => {
    try { const { data } = await api.get('/training-plans/logs'); setLogs(data); } catch {}
  };

  const openLog = async (logId) => {
    // 切换前把未保存的改动先冲掉
    if (dirtyRef.current.size > 0) await flushDirty();
    dirtyRef.current = new Set();
    setSyncState('idle');
    setLoading(true); setActiveLog(logId);
    try { const { data } = await api.get(`/training-plans/logs/${logId}`); setLogDetail(data); } catch {}
    setLoading(false);
  };

  // 点击"已导入·待建日志"的训练赛：按导入的比分自动建训练日志，再打开
  const openScrim = async (log) => {
    if (dirtyRef.current.size > 0) await flushDirty();
    dirtyRef.current = new Set();
    setSyncState('idle');
    setLoading(true);
    try {
      const maps = log.scrim_maps ? String(log.scrim_maps).split(',').map(s => s.trim()).filter(Boolean) : [];
      const { data } = await api.post('/training-plans/logs', { log_date: log.log_date, opponent: log.opponent, maps });
      const newId = data.log_id;
      await loadLogs();
      if (newId) {
        setActiveLog(newId);
        const { data: d2 } = await api.get(`/training-plans/logs/${newId}`);
        setLogDetail(d2);
      }
    } catch (e) { alert('建训练日志失败: ' + (e.response?.data?.error || e.message)); }
    setLoading(false);
  };

  // 只提交被本人修改过的回合(增量保存, 不覆盖他人改动)
  const flushDirty = async () => {
    const detail = detailRef.current;
    const logId = activeLogRef.current;
    if (!detail || !logId || dirtyRef.current.size === 0) return;
    const ids = new Set(dirtyRef.current); // 快照: 保存期间新产生的 dirty 不清除
    const dirtyRounds = detail.rounds.filter(r => ids.has(r.id));
    if (dirtyRounds.length === 0) return;
    setSyncState('saving');
    try {
      await api.put(`/training-plans/logs/${logId}/rounds`, { rounds: dirtyRounds });
      for (const id of ids) dirtyRef.current.delete(id);
      setSyncState(dirtyRef.current.size > 0 ? 'dirty' : 'saved');
    } catch (e) {
      setSyncState('error');
    }
  };

  // 编辑后 1.5 秒无操作自动保存
  const scheduleAutoSave = () => {
    if (saveTimerRef.current) clearTimeout(saveTimerRef.current);
    saveTimerRef.current = setTimeout(() => { flushDirty(); }, 1500);
  };

  // 手动保存按钮(立即冲掉全部未保存修改)
  const saveRounds = async () => {
    if (saveTimerRef.current) clearTimeout(saveTimerRef.current);
    setSaving(true);
    await flushDirty();
    setSaving(false);
  };

  // 每 12 秒拉取最新数据, 合并他人改动(本人未保存的行保留本地值)
  useEffect(() => {
    if (!activeLog) return;
    const timer = setInterval(async () => {
      const logId = activeLogRef.current;
      if (!logId) return;
      try {
        const { data } = await api.get(`/training-plans/logs/${logId}`);
        if (activeLogRef.current !== logId) return; // 期间切换了日志
        setLogDetail(prev => {
          if (!prev) return data;
          const localById = {};
          for (const r of prev.rounds) localById[r.id] = r;
          return {
            ...data,
            rounds: data.rounds.map(r =>
              dirtyRef.current.has(r.id) && localById[r.id] ? localById[r.id] : r
            ),
          };
        });
      } catch (e) {
        if (e.response?.status === 404) {
          alert('该日志已被其他用户删除');
          setActiveLog(null); setLogDetail(null);
          dirtyRef.current = new Set();
          loadLogs();
        }
      }
    }, 12000);
    return () => clearInterval(timer);
  }, [activeLog]);

  // 页面关闭/刷新前提醒未保存
  useEffect(() => {
    const onUnload = (e) => {
      if (dirtyRef.current.size > 0) { e.preventDefault(); e.returnValue = ''; }
    };
    window.addEventListener('beforeunload', onUnload);
    return () => window.removeEventListener('beforeunload', onUnload);
  }, []);

  const deleteLog = async (log, e) => {
    e.stopPropagation();
    if (!confirm(`确定删除 ${log.log_date} vs ${log.opponent} 的训练日志吗？所有回合记录将一并删除。`)) return;
    try {
      await api.delete(`/training-plans/logs/${log.id}`);
      if (activeLog === log.id) { setActiveLog(null); setLogDetail(null); dirtyRef.current = new Set(); }
      loadLogs();
    } catch(e2) { alert('删除失败: ' + (e2.response?.data?.error || e2.message)); }
  };

  const updateRound = (idx, field, value) => {
    setLogDetail(prev => {
      // 阵营自动分辨：改任一回合的阵营，同地图 1-12 同半场，13-24 自动反转
      if (field === 'team_side' && value) {
        const target = prev.rounds[idx];
        const num = parseInt((target.round_number || '').replace('R', '')) || 0;
        const firstHalfSide = num <= 12 ? value : (value === 'T' ? 'CT' : 'T');
        const secondHalfSide = firstHalfSide === 'T' ? 'CT' : 'T';
        return {
          ...prev,
          rounds: prev.rounds.map(r => {
            if (r.map_name !== target.map_name) return r;
            const n = parseInt((r.round_number || '').replace('R', '')) || 0;
            if (n >= 1 && n <= 12) { dirtyRef.current.add(r.id); return { ...r, team_side: firstHalfSide }; }
            if (n >= 13 && n <= 24) { dirtyRef.current.add(r.id); return { ...r, team_side: secondHalfSide }; }
            return r; // 加时赛(25+)不动
          }),
        };
      }
      const target = prev.rounds[idx];
      if (target) dirtyRef.current.add(target.id);
      const updated = { ...prev, rounds: prev.rounds.map((r, i) => i === idx ? { ...r, [field]: value } : r) };
      // 教练点评变更时自动模糊匹配犯错类型
      if (field === 'coach_comment' && value) {
        const match = fuzzyMatchError(value, errorTypes);
        if (match) {
          const round = updated.rounds[idx];
          if (!round.error_type_id) { // 仅在未手动选择时自动填入
            updated.rounds[idx] = { ...round, error_type_id: match.id };
          }
        }
      }
      return updated;
    });
    setSyncState('dirty');
    scheduleAutoSave();
  };

  const getBriefingTactics = (mapName, side, rt) => {
    if (!logDetail?.briefing?.tactics) return [];
    return logDetail.briefing.tactics.filter(t => (!mapName||t.map_name===mapName) && (!side||t.team_side===side) && (!rt||t.round_type===rt));
  };

  // ── 结构化失误编辑 ──
  const [errModal, setErrModal] = useState(null);  // { roundIdx }
  const setRoundErrors = (idx, errors) => {
    setLogDetail(prev => {
      const updated = { ...prev, rounds: prev.rounds.map((r,i)=> i===idx ? { ...r, errors } : r) };
      dirtyRef.current.add(prev.rounds[idx].id);
      return updated;
    });
    setSyncState('dirty');
    scheduleAutoSave();
  };

  const roundsByMap = {};
  if (logDetail?.rounds) {
    for (const r of logDetail.rounds) {
      if (!roundsByMap[r.map_name]) roundsByMap[r.map_name] = [];
      roundsByMap[r.map_name].push(r);
    }
  }

  return (
    <div className="flex gap-4">
      {/* 左侧列表 */}
      <div className="w-52 flex-shrink-0">
        <div className="flex items-center justify-between mb-2">
          <span className="text-sm text-gray-400 font-semibold">训练记录</span>
          {canEdit && (
            <button onClick={() => setNewLogModal(true)}
              className="text-xs px-2 py-1 rounded bg-ur-accent/10 border border-ur-accent/25 text-ur-accent hover:bg-ur-accent/20 transition-colors">
              + 新建
            </button>
          )}
        </div>
        {/* 搜索 */}
        <input value={logSearch} onChange={e => setLogSearch(e.target.value)}
          placeholder="搜索对手/日期..."
          className="w-full mb-2 h-8 px-2.5 rounded-lg bg-ur-card border border-ur-border text-xs text-white
                     placeholder:text-gray-600 focus:border-ur-accent/50 outline-none" />
        <div className="space-y-1.5">
          {logs
            .filter(log => !logSearch
              || (log.opponent||'').toLowerCase().includes(logSearch.toLowerCase())
              || (log.log_date||'').includes(logSearch))
            .map(log => (
            <div key={log.id || ('scrim-' + log.log_date + '-' + log.opponent)}
              onClick={() => log.scrim_only ? (canEdit ? openScrim(log) : null) : openLog(log.id)}
              title={log.scrim_only ? (canEdit ? '已导入训练赛比分，点击创建训练日志' : '已导入训练赛（待教练建日志）') : ''}
              className={`p-3 rounded-xl border transition-all group relative ${log.scrim_only && !canEdit ? 'cursor-default' : 'cursor-pointer'} ${activeLog===log.id && !log.scrim_only ? 'border-ur-accent/40 bg-ur-accent/8 text-ur-accent' : log.scrim_only ? 'border-dashed border-ur-amber/30 bg-ur-amber/[0.04] text-gray-300 hover:border-ur-amber/50' : 'border-ur-border bg-ur-card/40 text-gray-300 hover:border-gray-500'}`}>
              <div className="text-xs font-mono text-gray-500 mb-0.5">{log.log_date}</div>
              <div className="text-sm font-semibold truncate pr-10">{log.opponent}</div>
              {log.scrim_only ? (
                <div className="text-xs mt-0.5 flex items-center gap-1.5 min-w-0">
                  <span className="inline-flex px-1.5 py-0.5 rounded text-[10px] font-bold bg-ur-amber/15 text-ur-amber border border-ur-amber/30 flex-none">已导入·待建日志</span>
                  {log.scrim_maps && <span className="text-gray-600 truncate">{String(log.scrim_maps).split(',').join(' / ')}</span>}
                </div>
              ) : (
                <div className="text-xs text-gray-600 mt-0.5">{log.rounds_count} 回合</div>
              )}
              {canEdit && !log.scrim_only && (
                <div className="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                  <button onClick={(e) => { e.stopPropagation(); setEditLogModal(log); }}
                    title="编辑"
                    className="w-6 h-6 rounded text-[11px] text-gray-400 hover:text-ur-accent bg-black/30 transition-colors">✎</button>
                  <button onClick={(e) => deleteLog(log, e)}
                    title="删除"
                    className="w-6 h-6 rounded text-[11px] text-gray-400 hover:text-ur-rose bg-black/30 transition-colors">✕</button>
                </div>
              )}
            </div>
          ))}
          {logs.length === 0 && <p className="text-xs text-gray-600 text-center py-4">暂无训练记录</p>}
        </div>
      </div>

      {/* 右侧详情 */}
      <div className="flex-1 min-w-0">
        {!activeLog ? (
          <div className="data-card text-center py-16">
            <div className="text-4xl opacity-20 mb-3">📝</div>
            <p className="text-gray-500">从左侧选择训练记录</p>
          </div>
        ) : loading ? (
          <div className="data-card text-center py-16"><p className="text-gray-500 animate-pulse">加载中...</p></div>
        ) : logDetail && (
          <>
            {(() => {
              const mapKeys = Object.keys(roundsByMap);
              const effMap = mapKeys.includes(activeMapTab) ? activeMapTab : mapKeys[0];
              const es = logDetail.execStats || {};
              const execRate = es.tactic_exec_rate;
              const fdRate = es.fd_active_rate;
              const GRID = '52px 74px minmax(140px,1.1fr) 92px 74px minmax(110px,1fr) 100px';
              const inSt = { height: 32, padding: '0 10px', border: '1px solid rgba(90,130,255,.22)', background: 'rgba(10,17,46,.55)', color: '#e9efff', fontSize: 12.5, outline: 'none', minWidth: 0, width: '100%' };
              const selSt = { height: 32, padding: '0 6px', border: '1px solid rgba(90,130,255,.28)', background: 'rgba(10,17,46,.9)', color: '#e9efff', fontSize: 12.5, outline: 'none', width: '100%' };
              const badgeSt = (v) => ({ display: 'inline-flex', padding: '3px 12px', fontSize: 11.5, fontWeight: 800, color: '#04122c', clipPath: 'polygon(5px 0,100% 0,calc(100% - 5px) 100%,0 100%)', background: v === '成功' ? '#34d399' : v === '部分成功' ? '#fbbf24' : v === '失败' ? '#f87171' : 'rgba(114,136,189,.4)' });
              return (
            <>
            {/* ═══ 对局头卡（design 版式） ═══ */}
            <div className="mb-4" style={{ border: '1px solid rgba(80,120,255,.30)', background: 'linear-gradient(90deg,rgba(13,22,60,.9),rgba(7,12,34,.9))', clipPath: 'polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,0 100%)', padding: '18px 22px', display: 'flex', alignItems: 'center', gap: 22, flexWrap: 'wrap' }}>
              <div>
                <div className="text-white" style={{ fontSize: 20, fontWeight: 800 }}>vs {logDetail.log.opponent}</div>
                <div style={{ fontSize: 12.5, color: '#8fa5d8', marginTop: 4 }}>
                  {logDetail.log.log_date}
                  {logDetail.briefing && <> · <span style={{ color: '#34d399' }}>✓ 关联简报</span> {logDetail.briefing.map1_name} / {logDetail.briefing.map2_name}</>}
                </div>
              </div>
              <span style={{ width: 1, height: 38, background: 'rgba(70,110,255,.25)' }} />
              <div style={{ textAlign: 'center' }}>
                <div style={{ fontSize: 11, letterSpacing: 1, color: '#8fa5d8' }}>战术执行率</div>
                <div style={{ fontFamily: "'Rajdhani',sans-serif", fontSize: 24, fontWeight: 700, marginTop: 2, color: execRate == null ? '#7288bd' : execRate >= 70 ? '#34d399' : execRate >= 50 ? '#fbbf24' : '#f87171' }}>{execRate != null ? `${execRate}%` : '—'}</div>
              </div>
              <div style={{ textAlign: 'center' }}>
                <div style={{ fontSize: 11, letterSpacing: 1, color: '#8fa5d8' }}>主动首死率</div>
                <div style={{ fontFamily: "'Rajdhani',sans-serif", fontSize: 24, fontWeight: 700, marginTop: 2, color: fdRate == null ? '#7288bd' : fdRate <= 30 ? '#34d399' : fdRate <= 60 ? '#fbbf24' : '#f87171' }}>{fdRate != null ? `${fdRate}%` : '—'}</div>
              </div>
              <span style={{ flex: 1 }} />
              <div style={{ display: 'flex', gap: 8 }}>
                {mapKeys.map(m => (
                  <div key={m} onClick={() => setActiveMapTab(m)}
                    style={{ height: 34, padding: '0 18px', fontSize: 13, display: 'flex', alignItems: 'center', cursor: 'pointer', clipPath: 'polygon(6px 0,100% 0,calc(100% - 6px) 100%,0 100%)',
                      ...(m === effMap
                        ? { background: 'linear-gradient(90deg,#3b82f6,#22d3ee)', color: '#04122c', fontWeight: 800 }
                        : { border: '1px solid rgba(90,130,255,.3)', background: 'rgba(18,28,72,.6)', color: '#9db0dd', fontWeight: 600 }) }}>
                    {m}
                  </div>
                ))}
              </div>
              {canEdit && (
                <>
                <span style={{ fontSize: 11.5, color: syncState === 'error' ? '#f87171' : syncState === 'saved' ? '#34d399' : (syncState === 'dirty' || syncState === 'saving') ? '#fbbf24' : '#7288bd' }}>
                  {syncState === 'saving' ? '保存中…' : syncState === 'saved' ? '✓ 已自动保存' : syncState === 'dirty' ? '● 编辑中…' : syncState === 'error' ? '✕ 保存失败,点击重试' : '支持多人同时录入'}
                </span>
                <div onClick={saving ? undefined : saveRounds}
                  style={{ height: 36, padding: '0 20px', background: 'linear-gradient(90deg,#3b82f6,#22d3ee)', fontSize: 13, fontWeight: 700, color: '#04122c', display: 'flex', alignItems: 'center', cursor: 'pointer', clipPath: 'polygon(8px 0,100% 0,calc(100% - 8px) 100%,0 100%)', opacity: saving ? 0.5 : 1 }}>
                  {saving ? '保存中...' : '立即保存'}
                </div>
                </>
              )}
            </div>

            {/* ═══ 逐回合表（design 版式：每回合两行） ═══ */}
            <div className="mb-4" style={{ border: '1px solid rgba(80,120,255,.30)', background: 'linear-gradient(180deg,rgba(12,20,56,.9),rgba(7,12,34,.9))', clipPath: 'polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,0 100%)', padding: '18px 20px' }}>
              <div style={{ display: 'grid', gridTemplateColumns: GRID, gap: 10, padding: '7px 12px', background: 'rgba(20,32,80,.55)', fontSize: 12, color: '#8fa5d8' }}>
                <div>回合</div><div>阵营</div><div>IGL指令 / 教练战术</div><div>首死</div><div>时间</div><div>首死原因</div><div style={{ textAlign: 'center' }}>执行结果</div>
              </div>
              {(roundsByMap[effMap] || []).map(r => {
                const gi = logDetail.rounds.indexOf(r);
                const bTactics = getBriefingTactics(effMap, r.team_side, null);
                const allMapTactics = allTactics.filter(t => t.map_name === effMap || !effMap);
                const tacticOpts = bTactics.length > 0 ? bTactics : allMapTactics;
                const briefingTacticIds = new Set((logDetail?.briefing?.tactics || []).map(t => t.tactic_id));
                const coachTacticMatched = r.igl_tactic_id ? briefingTacticIds.has(r.igl_tactic_id) : null;
                const canEditRound = isAdmin || isCoach || isTeamLead;
                const canEditSide = isAdmin || isCoach || isTeamLead;
                const canEditIgl = isAdmin || isTeamLead;
                const canEditFd = isAdmin || isTeamLead;
                const canEditExec = isAdmin || isCoach;
                const canEditComment = isAdmin || isCoach;
                const canEditErr = isAdmin || isCoach;
                const errs = r.errors || [];
                return (
                <div key={r.id} style={{ borderBottom: '1px solid rgba(70,110,255,.14)', background: r.execution === '失败' ? 'rgba(248,113,113,.04)' : undefined }}>
                  {/* 行1 */}
                  <div style={{ display: 'grid', gridTemplateColumns: GRID, gap: 10, alignItems: 'center', padding: '9px 12px 4px' }}>
                    <div>
                      {canEditRound ? (
                        <input value={r.round_number || ''} onChange={e => updateRound(gi, 'round_number', e.target.value)} style={{ ...inSt, padding: '0 6px', fontFamily: "'Rajdhani',monospace", fontWeight: 700, color: '#7ea4ff' }} />
                      ) : (
                        <span style={{ fontFamily: "'Rajdhani',sans-serif", fontSize: 15, fontWeight: 700, color: '#7ea4ff' }}>{r.round_number}</span>
                      )}
                    </div>
                    <div>
                      {canEditSide ? (
                        <select value={r.team_side || ''} onChange={e => updateRound(gi, 'team_side', e.target.value)} style={selSt}>
                          <option value="">-</option><option value="T">T</option><option value="CT">CT</option>
                        </select>
                      ) : (
                        <span className={`inline-flex px-1.5 py-0.5 rounded text-[11px] font-bold border ${SIDE_COLORS[r.team_side]?.text} ${SIDE_COLORS[r.team_side]?.bg} ${SIDE_COLORS[r.team_side]?.border}`}>{r.team_side || '-'}</span>
                      )}
                    </div>
                    <div style={{ minWidth: 0 }}>
                      {canEditIgl ? (
                        <>
                        <SearchableSelect
                          value={r.igl_tactic_id || ''}
                          options={tacticOpts.map(t => ({ value: t.tactic_id, label: t.tactic_name || t.name }))}
                          onChange={(v) => updateRound(gi, 'igl_tactic_id', v)}
                          placeholder="搜索战术…"
                          className="w-full h-8 px-2.5 text-xs text-ur-accent outline-none border border-[rgba(90,130,255,.22)] bg-[rgba(10,17,46,.55)] placeholder:text-gray-700" />
                        {r.igl_tactic_note ? <div className="text-gray-300 text-[11px] mt-1 whitespace-pre-wrap break-words">{r.igl_tactic_note}</div> : null}
                        </>
                      ) : (
                        (() => {
                          const iglTactic = tacticOpts.find(t => t.tactic_id === r.igl_tactic_id);
                          const iglName = iglTactic ? (iglTactic.tactic_name || iglTactic.name) : null;
                          return <span className="text-gray-300 text-[11px] whitespace-pre-wrap break-words">{r.igl_tactic_note || iglName || '-'}</span>;
                        })()
                      )}
                      {coachTacticMatched !== null && (
                        coachTacticMatched
                          ? <div style={{ fontSize: 10, color: '#34d399', marginTop: 2 }} title="已在简报中匹配">✓ 简报战术</div>
                          : <div style={{ fontSize: 10, color: '#f87171', marginTop: 2 }} title="未在简报中找到对应战术">✗ 简报外</div>
                      )}
                    </div>
                    <div>
                      {canEditFd ? (
                        <select value={r.fd_player || ''} onChange={e => updateRound(gi, 'fd_player', e.target.value)} style={selSt}>
                          <option value="">-</option>
                          {(r.fd_player && !roster.includes(r.fd_player) ? [r.fd_player, ...roster] : roster).map(p => <option key={p} value={p}>{p}</option>)}
                        </select>
                      ) : (
                        <span className="text-gray-300 text-xs">{r.fd_player || '-'}</span>
                      )}
                    </div>
                    <div>
                      {canEditFd ? (
                        <input value={(r.fd_time || '').replace(/：/g, ':')} onChange={e => updateRound(gi, 'fd_time', e.target.value.replace(/：/g, ':'))} placeholder="01:30" style={{ ...inSt, padding: '0 8px', textAlign: 'center', fontFamily: 'monospace' }} />
                      ) : (
                        <span className="font-mono text-gray-300 text-xs">{(r.fd_time || '-').replace(/：/g, ':')}</span>
                      )}
                    </div>
                    <div style={{ minWidth: 0 }}>
                      {canEditFd ? (
                        <SearchableSelect
                          value={r.fd_cause || ''}
                          options={fdCauses.map(c => ({ value: c, label: c }))}
                          onChange={(v) => updateRound(gi, 'fd_cause', v)}
                          placeholder="搜索/新增…"
                          allowAdd
                          onAdd={addFdCause}
                          className="w-full h-8 px-2.5 text-xs text-white outline-none border border-[rgba(90,130,255,.22)] bg-[rgba(10,17,46,.55)] placeholder:text-gray-700" />
                      ) : (
                        <span className="text-gray-300 text-xs">{r.fd_cause || '-'}</span>
                      )}
                    </div>
                    <div style={{ textAlign: 'center' }}>
                      {canEditExec ? (
                        <select value={r.execution || ''} onChange={e => updateRound(gi, 'execution', e.target.value)} style={{ ...selSt, textAlign: 'center', fontWeight: 700, color: r.execution === '成功' ? '#34d399' : r.execution === '部分成功' ? '#fbbf24' : r.execution === '失败' ? '#f87171' : '#e9efff' }}>
                          <option value="">-</option>
                          {EXEC_OPTIONS.map(o => <option key={o} value={o}>{o}</option>)}
                        </select>
                      ) : (
                        <span style={badgeSt(r.execution)}>{r.execution || '-'}</span>
                      )}
                    </div>
                  </div>
                  {/* 行2：失误 + 评语（缩进 74px 通栏） */}
                  <div style={{ display: 'grid', gridTemplateColumns: 'minmax(200px,0.8fr) minmax(0,2.4fr)', gap: 10, padding: '4px 12px 10px 74px' }}>
                    <div style={{ display: 'flex', alignItems: 'center', gap: 8, minWidth: 0, flexWrap: 'wrap' }}>
                      <span style={{ fontSize: 11, color: '#5f74b3', flex: 'none' }}>失误</span>
                      {errs.map((e, ei) => (
                        <span key={ei} style={{ display: 'inline-flex', padding: '2px 10px', fontSize: 11.5, fontWeight: 700, color: '#f87171', border: '1px solid rgba(248,113,113,.45)', background: 'rgba(248,113,113,.08)', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
                          {e.category || '?'}·{e.responsible || '全队'}{e.co_responsible ? '+' : ''}
                        </span>
                      ))}
                      {errs.length === 0 && !canEditErr && <span style={{ fontSize: 11, color: '#5f74b3' }}>无</span>}
                      {canEditErr && (
                        <span onClick={() => setErrModal({ roundIdx: gi })} style={{ fontSize: 11.5, color: '#7ea4ff', cursor: 'pointer', flex: 'none' }} className="hover:text-white">
                          {errs.length > 0 ? '编辑' : '+ 记录失误'}
                        </span>
                      )}
                    </div>
                    <div style={{ display: 'flex', alignItems: 'center', gap: 8, minWidth: 0 }}>
                      <span style={{ fontSize: 11, color: '#5f74b3', flex: 'none' }}>评语</span>
                      {canEditComment ? (
                        <textarea value={r.coach_comment || ''} onChange={e => updateRound(gi, 'coach_comment', e.target.value)} placeholder="点评…" rows={2}
                          style={{ flex: 1, minHeight: 30, padding: '5px 10px', border: '1px solid rgba(90,130,255,.18)', background: 'rgba(10,17,46,.45)', color: '#c7d4f5', fontSize: 12.5, outline: 'none', minWidth: 0, resize: 'vertical', lineHeight: 1.5, fontFamily: 'inherit' }} />
                      ) : (
                        <span className="text-gray-400 text-xs whitespace-pre-wrap">{r.coach_comment || '-'}</span>
                      )}
                    </div>
                  </div>
                </div>
                );
              })}
            </div>
            </>
              );
            })()}
          </>
        )}
      </div>

      {newLogModal && (
        <NewLogModal onClose={() => setNewLogModal(false)} onCreated={(id) => { setNewLogModal(false); loadLogs(); openLog(id); }} />
      )}
      {errModal && logDetail && (
        <ErrorEditModal
          round={logDetail.rounds[errModal.roundIdx]}
          errorTypes={errorTypes}
          roster={roster}
          onClose={() => setErrModal(null)}
          onSave={(errors) => { setRoundErrors(errModal.roundIdx, errors); setErrModal(null); }}
        />
      )}
      {editLogModal && (
        <EditLogModal log={editLogModal}
          onClose={() => setEditLogModal(null)}
          onSaved={() => { setEditLogModal(null); loadLogs(); if (activeLog === editLogModal.id) openLog(editLogModal.id); }} />
      )}
    </div>
  );
}

// ── 结构化失误编辑弹窗（路线甲核心）────────────────────────
function ErrorEditModal({ round, errorTypes, roster = [], onClose, onSave }) {
  const [errors, setErrors] = useState(() => (round.errors || []).map(e => ({ ...e })));
  // 失误大类（去重 category）
  const categories = [...new Set(errorTypes.map(t => t.category))];

  const addError = () => setErrors(prev => [...prev, { category: '', responsible: '', co_responsible: '', detail: '' }]);
  const removeError = (i) => setErrors(prev => prev.filter((_, idx) => idx !== i));
  const upd = (i, field, val) => setErrors(prev => prev.map((e, idx) => idx === i ? { ...e, [field]: val } : e));
  const toggleCo = (i, player) => setErrors(prev => prev.map((e, idx) => {
    if (idx !== i) return e;
    const list = (e.co_responsible ? String(e.co_responsible).split(',').filter(Boolean) : []);
    const next = list.includes(player) ? list.filter(p => p !== player) : [...list, player];
    return { ...e, co_responsible: next.join(',') };
  }));

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4" onClick={onClose}>
      <div className="glass-panel rounded-lg p-6 max-w-2xl w-full max-h-[85vh] overflow-auto" onClick={e => e.stopPropagation()}>
        <div className="flex items-center justify-between mb-4">
          <h3 className="text-lg font-bold text-white">{round.map_name} {round.round_number} · 失误记录</h3>
          <button onClick={onClose} className="w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/[0.08] text-2xl">&times;</button>
        </div>
        <p className="text-xs text-gray-500 mb-4">一回合可记录多条失误。主责必填，连带责任人可多选（连带也计入个人失误统计）。</p>

        <div className="space-y-3">
          {errors.length === 0 && <p className="text-sm text-gray-600 text-center py-6">暂无失误记录，点下方按钮添加</p>}
          {errors.map((e, i) => {
            const coList = e.co_responsible ? String(e.co_responsible).split(',').filter(Boolean) : [];
            return (
              <div key={i} className="rounded-lg border border-ur-border bg-ur-bg/40 p-3">
                <div className="flex items-start gap-2 flex-wrap mb-2">
                  <div className="flex flex-col gap-1">
                    <label className="text-[11px] text-gray-500">失误类型</label>
                    <select value={e.category||''} onChange={ev=>upd(i,'category',ev.target.value)}
                      className="bg-ur-bg border border-ur-border rounded px-2 py-1 text-white text-xs outline-none focus:border-ur-accent/40 w-24">
                      <option value="">选择</option>
                      {categories.map(c=><option key={c} value={c}>{c}</option>)}
                    </select>
                  </div>
                  <div className="flex flex-col gap-1">
                    <label className="text-[11px] text-gray-500">主责</label>
                    <select value={e.responsible||''} onChange={ev=>upd(i,'responsible',ev.target.value)}
                      className="bg-ur-bg border border-ur-border rounded px-2 py-1 text-white text-xs outline-none focus:border-ur-accent/40 w-24">
                      <option value="">选择</option>
                      {(e.responsible && e.responsible !== '全队' && !roster.includes(e.responsible) ? [e.responsible, ...roster] : roster).map(p=><option key={p} value={p}>{p}</option>)}
                      <option value="全队">全队</option>
                    </select>
                  </div>
                  <div className="flex flex-col gap-1 flex-1 min-w-[160px]">
                    <label className="text-[11px] text-gray-500">连带责任人（可多选）</label>
                    <div className="flex flex-wrap gap-1">
                      {[...new Set([...roster, ...coList])].filter(p=>p!==e.responsible).map(p=>(
                        <button key={p} onClick={()=>toggleCo(i,p)}
                          className={`px-2 py-0.5 rounded text-[11px] border transition-colors ${
                            coList.includes(p) ? 'bg-ur-accent/20 text-ur-accent border-ur-accent/40' : 'bg-ur-bg text-gray-500 border-ur-border hover:text-gray-300'
                          }`}>{p}</button>
                      ))}
                    </div>
                  </div>
                  <button onClick={()=>removeError(i)} className="text-ur-rose hover:bg-ur-rose/10 rounded px-2 py-1 text-xs self-start mt-5">删除</button>
                </div>
                <div className="flex flex-col gap-1">
                  <label className="text-[11px] text-gray-500">描述</label>
                  <input value={e.detail||''} onChange={ev=>upd(i,'detail',ev.target.value)}
                    placeholder="如：VIP烟丢呲 / 二楼走位撞一起"
                    className="bg-ur-bg border border-ur-border rounded px-2 py-1 text-white text-xs outline-none focus:border-ur-accent/40 w-full" />
                </div>
              </div>
            );
          })}
        </div>

        <button onClick={addError}
          className="mt-3 px-4 py-2 rounded-lg border border-dashed border-ur-accent/40 text-ur-accent text-sm hover:bg-ur-accent/10 transition-colors w-full">
          + 添加一条失误
        </button>

        <div className="flex justify-end gap-2 mt-5 pt-4 border-t border-ur-border">
          <button onClick={onClose} className="px-4 py-2 rounded-lg border border-ur-border text-gray-400 text-sm hover:text-white">取消</button>
          <button onClick={()=>onSave(errors.filter(e=>e.responsible||e.category||e.detail))}
            className="px-4 py-2 rounded-lg bg-ur-accent/20 border border-ur-accent/40 text-ur-accent text-sm font-semibold hover:bg-ur-accent/30">
            保存失误
          </button>
        </div>
      </div>
    </div>
  );
}

// ── 编辑日志弹窗 ────────────────────────────────────────────
function EditLogModal({ log, onClose, onSaved }) {
  const [form, setForm] = useState({ log_date: log.log_date, opponent: log.opponent });
  const [saving, setSaving] = useState(false);

  const save = async () => {
    if (!form.opponent) return alert('请填写对手名称');
    setSaving(true);
    try {
      await api.put(`/training-plans/logs/${log.id}`, form);
      onSaved();
    } catch(e) { alert('保存失败: ' + (e.response?.data?.error || e.message)); }
    setSaving(false);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60" onClick={onClose}>
      <div className="bg-ur-bg border border-ur-border rounded-lg w-full max-w-sm p-6" onClick={e=>e.stopPropagation()}>
        <h3 className="font-sans font-semibold text-xl font-bold text-white mb-5">编辑训练日志</h3>
        <div className="space-y-3">
          <div>
            <label className="text-xs text-gray-500 block mb-1">训练日期</label>
            <input type="date" value={form.log_date} onChange={e=>setForm({...form,log_date:e.target.value})}
              className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none [color-scheme:dark]" />
          </div>
          <div>
            <label className="text-xs text-gray-500 block mb-1">对手</label>
            <input value={form.opponent} onChange={e=>setForm({...form,opponent:e.target.value})}
              className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none focus:border-ur-accent/50" />
          </div>
          <p className="text-xs text-gray-600">改日期后会自动重新关联该日期的简报</p>
        </div>
        <div className="flex justify-end gap-3 mt-5">
          <button onClick={onClose} className="text-sm text-gray-400 hover:text-white px-4 py-2">取消</button>
          <button onClick={save} disabled={saving}
            className="px-5 py-2 rounded-lg bg-ur-accent/15 border border-ur-accent/30 text-ur-accent text-sm font-semibold hover:bg-ur-accent/25 disabled:opacity-50 transition-colors">
            {saving ? '保存中...' : '保存'}
          </button>
        </div>
      </div>
    </div>
  );
}

function NewLogModal({ onClose, onCreated }) {
  const today = new Date().toISOString().split('T')[0];
  const [form, setForm] = useState({ log_date: today, opponent: '', map1: '', map2: '' });
  const [creating, setCreating] = useState(false);
  const [briefingInfo, setBriefingInfo] = useState(null); // 当日简报信息

  // 日期变化时检查是否有简报
  useEffect(() => {
    setBriefingInfo(null);
    api.get(`/training-plans/briefings/${form.log_date}`)
      .then(r => setBriefingInfo(r.data))
      .catch(() => setBriefingInfo(null));
  }, [form.log_date]);

  const create = async () => {
    if (!form.opponent) return alert('请填写对手名称');
    // 无简报时必须手动选图
    if (!briefingInfo && !form.map1 && !form.map2) {
      return alert('当日无简报，请至少选择一张训练地图');
    }
    setCreating(true);
    try {
      const { data } = await api.post('/training-plans/logs', {
        log_date: form.log_date,
        opponent: form.opponent,
        maps: [form.map1, form.map2].filter(Boolean),
      });
      onCreated(data.log_id);
    }
    catch(e) { alert('创建失败: ' + (e.response?.data?.error || e.message)); }
    setCreating(false);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60" onClick={onClose}>
      <div className="bg-ur-bg border border-ur-border rounded-lg w-full max-w-sm p-6" onClick={e=>e.stopPropagation()}>
        <h3 className="font-sans font-semibold text-xl font-bold text-white mb-5">新建训练日志</h3>
        <div className="space-y-3">
          <div>
            <label className="text-xs text-gray-500 block mb-1">训练日期</label>
            <input type="date" value={form.log_date} onChange={e=>setForm({...form,log_date:e.target.value})}
              className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none [color-scheme:dark]" />
          </div>
          <div>
            <label className="text-xs text-gray-500 block mb-1">对手</label>
            <input value={form.opponent} onChange={e=>setForm({...form,opponent:e.target.value})}
              placeholder="对手队名"
              className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none focus:border-ur-accent/50" />
          </div>

          {briefingInfo ? (
            <div className="px-3 py-2.5 rounded-lg bg-emerald-500/8 border border-emerald-500/25 text-xs text-emerald-400">
              ✓ 检测到当日简报（{briefingInfo.map1_name || '?'} / {briefingInfo.map2_name || '?'}），将自动关联并生成回合框架
            </div>
          ) : (
            <>
              <div className="px-3 py-2.5 rounded-lg bg-yellow-500/8 border border-yellow-500/25 text-xs text-yellow-400">
                当日无简报，请手动选择训练地图
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs text-gray-500 block mb-1">地图一</label>
                  <select value={form.map1} onChange={e=>setForm({...form,map1:e.target.value})}
                    className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none">
                    <option value="">不选</option>
                    {MAP_OPTIONS.map(m => <option key={m.abbr} value={m.name}>{m.name}</option>)}
                  </select>
                </div>
                <div>
                  <label className="text-xs text-gray-500 block mb-1">地图二</label>
                  <select value={form.map2} onChange={e=>setForm({...form,map2:e.target.value})}
                    className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none">
                    <option value="">不选</option>
                    {MAP_OPTIONS.map(m => <option key={m.abbr} value={m.name}>{m.name}</option>)}
                  </select>
                </div>
              </div>
            </>
          )}
        </div>
        <div className="flex justify-end gap-3 mt-5">
          <button onClick={onClose} className="text-sm text-gray-400 hover:text-white px-4 py-2">取消</button>
          <button onClick={create} disabled={creating}
            className="px-5 py-2 rounded-lg bg-ur-accent/15 border border-ur-accent/30 text-ur-accent text-sm font-semibold hover:bg-ur-accent/25 disabled:opacity-50 transition-colors">
            {creating ? '创建中...' : '创建'}
          </button>
        </div>
      </div>
    </div>
  );
}

