              {/* 该局型的 T/CT 两块 */}
              {['T','CT'].map(side => {
                const rows = slotTactics[slot][side][activeRt] || [];
                const sc = SIDE_COLORS[side];
                const opts = getTacticOptions(mapName, side, activeRt);
                return (
                  <div key={side} className="mb-3">
