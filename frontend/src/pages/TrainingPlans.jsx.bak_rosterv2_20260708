// ── 战术名输入选择器：输入战术名 → 自动生成编号 ──
function TacticNamePicker({ value, onChange, options }) {
  const selected = options.find(o => o.tactic_id === value);
  const [query, setQuery] = useState('');
  const [open, setOpen] = useState(false);

  const list = options.filter(o =>
    !query ||
    o.name.toLowerCase().includes(query.toLowerCase()) ||
    (o.alias || '').toLowerCase().includes(query.toLowerCase())
  );

  return (
    <div className="relative flex-1" style={{ minWidth: 150 }}>
      <input
        value={open ? query : (selected?.name || '')}
        onFocus={() => { setOpen(true); setQuery(''); }}
        onBlur={() => setTimeout(() => setOpen(false), 150)}
        onChange={e => {
          const v = e.target.value;
          setQuery(v); setOpen(true);
          const exact = options.find(o => o.name === v);
          if (exact) onChange(exact.tactic_id);
        }}
        placeholder="输入战术名..."
        className="w-full bg-ur-bg border border-ur-border rounded px-2 py-1 text-xs text-white
                   outline-none focus:border-ur-accent/50 placeholder:text-gray-700" />
      {open && list.length > 0 && (
        <div className="absolute z-30 left-0 right-0 top-full mt-1 max-h-52 overflow-y-auto
                        rounded-lg border border-ur-border bg-ur-card shadow-xl">
          {list.slice(0, 15).map(o => (
            <div key={o.tactic_id}
              onMouseDown={() => { onChange(o.tactic_id); setOpen(false); }}
              className="flex items-center justify-between gap-2 px-2.5 py-1.5 cursor-pointer
                         hover:bg-ur-accent/10 transition-colors">
              <span className="text-xs text-white truncate">{o.name}</span>
              <span className="text-[10px] font-mono text-ur-accent flex-shrink-0">{o.tactic_id}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

// ── 模糊搜索选择器：文本输入 → 过滤下拉 → 选中/新增 ──
function SearchableSelect({ value, options, onChange, placeholder, allowAdd, onAdd, className }) {
  const selected = options.find(o => o.value === value);
  const [query, setQuery] = useState('');
  const [open, setOpen] = useState(false);

  const filtered = options.filter(o =>
    !query || o.label.toLowerCase().includes(query.toLowerCase())
  );

  const handleSelect = (val) => { onChange(val); setOpen(false); };

  return (
    <div className="relative" style={{ minWidth: 100 }}>
      <input
        value={open ? query : (selected?.label || '')}
        onFocus={() => { setOpen(true); setQuery(''); }}
        onBlur={() => setTimeout(() => setOpen(false), 150)}
        onChange={e => {
          const v = e.target.value;
          setQuery(v); setOpen(true);
          const exact = options.find(o => o.label === v);
          if (exact) onChange(exact.value);
        }}
        placeholder={placeholder}
        className={className || "w-full bg-ur-bg border border-ur-border rounded px-1.5 py-0.5 text-white text-xs outline-none focus:border-ur-accent/40 placeholder:text-gray-700"} />
      {open && (filtered.length > 0 || (allowAdd && query)) && (
        <div className="absolute z-30 left-0 right-0 top-full mt-1 max-h-40 overflow-y-auto
                        rounded-lg border border-ur-border bg-ur-card shadow-xl">
          {filtered.slice(0, 20).map(o => (
            <div key={o.value}
              onMouseDown={() => handleSelect(o.value)}
              className="px-2.5 py-1.5 cursor-pointer hover:bg-ur-accent/10 transition-colors text-xs text-white truncate">
              {o.label}
            </div>
          ))}
          {allowAdd && query && !options.some(o => o.label === query) && (
            <div
              onMouseDown={() => { if (onAdd) { onAdd(query); onChange(query); } setOpen(false); }}
              className="px-2.5 py-1.5 cursor-pointer hover:bg-emerald-500/10 transition-colors text-xs text-emerald-400 border-t border-ur-border">
              + 添加 "{query}"
            </div>
          )}
        </div>
      )}
    </div>
  );
}

