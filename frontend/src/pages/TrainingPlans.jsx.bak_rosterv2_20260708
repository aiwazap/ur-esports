// 每日简报
// ════════════════════════════════════════════════════════════
function BriefingTab({ canEdit }) {
  const today = new Date().toISOString().split('T')[0];
  const [date, setDate] = useState(today);
  const [briefing, setBriefing] = useState(null);
  const [allTactics, setAllTactics] = useState([]);
  const [saving, setSaving] = useState(false);

  // 基本信息
  const [form, setForm] = useState({
    opponent: '', vrs_rank: '', map1_name: '', map2_name: '', notes: '',
  });

  // 两张图各自的战术条目，按局型分组存储
  // structure: { M1: { T: { P:[], F:[], A:[], H:[], E:[] }, CT: {...} }, M2: {...} }
  const emptySlot = () => ({
    T:  { P:[], F:[], A:[], H:[], E:[] },
    CT: { P:[], F:[], A:[], H:[], E:[] },
  });
  const [slotTactics, setSlotTactics] = useState({ M1: emptySlot(), M2: emptySlot() });

  // 激活的局型标签
  const [activeRound, setActiveRound] = useState({ M1: 'P', M2: 'P' });

  // 历史简报列表
  const [history, setHistory] = useState([]);
  const loadHistory = () => {
    api.get('/training-plans/briefings').then(r => setHistory(r.data)).catch(() => {});
  };
  const deleteBriefing = async (e, bdate) => {
    e.stopPropagation();
    if (!confirm(`确定删除 ${bdate} 的简报吗？此操作不可恢复。`)) return;
    try {
      await api.delete(`/training-plans/briefings/${bdate}`);
      loadHistory();
    } catch(err) { alert('删除失败: ' + (err.response?.data?.error || err.message)); }
  };

  useEffect(() => {
    api.get('/training-plans/tactics').then(r => setAllTactics(r.data)).catch(() => {});
    loadHistory();
  }, []);

  const load = async (d) => {
    try {
      const { data } = await api.get(`/training-plans/briefings/${d}`);
      setBriefing(data);
      setForm({
        opponent: data.opponent || '',
        vrs_rank: data.vrs_rank || '',
        map1_name: data.map1_name || '',
        map2_name: data.map2_name || '',
        notes: data.notes || '',
      });
      // 重建 slotTactics
      const rebuilt = { M1: emptySlot(), M2: emptySlot() };
      for (const t of (data.tactics || [])) {
        const slot = t.map_slot || 'M1';
        const side = t.team_side || 'T';
        const rt   = t.round_type || 'F';
        if (rebuilt[slot]?.[side]?.[rt]) {
          rebuilt[slot][side][rt].push(t);
        }
      }
      setSlotTactics(rebuilt);
    } catch {
      setBriefing(null);
      setForm({ opponent: '', vrs_rank: '', map1_name: '', map2_name: '', notes: '' });
      setSlotTactics({ M1: emptySlot(), M2: emptySlot() });
    }
  };
  useEffect(() => { load(date); }, [date]);

  // 添加战术行
  const addTacticRow = (slot, side, rt) => {
    setSlotTactics(prev => {
      const next = JSON.parse(JSON.stringify(prev));
      next[slot][side][rt].push({ _tmp: Date.now(), tactic_id: '', instruction: '' });
      return next;
    });
  };
  const removeTacticRow = (slot, side, rt, idx) => {
    setSlotTactics(prev => {
      const next = JSON.parse(JSON.stringify(prev));
      next[slot][side][rt].splice(idx, 1);
      return next;
    });
  };
  const updateTacticRow = (slot, side, rt, idx, field, value) => {
    setSlotTactics(prev => {
      const next = JSON.parse(JSON.stringify(prev));
      next[slot][side][rt][idx][field] = value;
      return next;
    });
  };

  // 把 slotTactics 展平为数组
  const flattenTactics = () => {
    const result = [];
    for (const [slot, sides] of Object.entries(slotTactics)) {
      const mapName = slot === 'M1' ? form.map1_name : form.map2_name;
      for (const [side, rounds] of Object.entries(sides)) {
        for (const [rt, rows] of Object.entries(rounds)) {
          for (const row of rows) {
            if (row.tactic_id) {
              result.push({ map_slot: slot, map_name: mapName, team_side: side, round_type: rt, tactic_id: row.tactic_id, instruction: row.instruction || '' });
            }
          }
        }
      }
    }
    return result;
  };

  // 获取战术选项
  const getTacticOptions = (mapName, side, rt) => {
    const abbr = MAP_ABBR_MAP[(mapName||'').toLowerCase()] || '';
    return allTactics.filter(t =>
      (!abbr || t.map_abbr === abbr) &&
      t.team_side === side &&
      t.round_type === rt
    );
  };

  const save = async (published = false) => {
    setSaving(true);
    try {
      await api.post('/training-plans/briefings', {
        date, ...form, tactics: flattenTactics(), published,
      });
      load(date);
      loadHistory();
      alert(published ? '简报已发布！' : '草稿已保存');
    } catch(e) { alert('保存失败: ' + (e.response?.data?.error || e.message)); }
    setSaving(false);
  };

  const SLOTS = [
    { slot: 'M1', label: '图一 · 我方选图', mapKey: 'map1_name' },
    { slot: 'M2', label: '图二 · 对方选图', mapKey: 'map2_name' },
  ];

  return (
    <div>
      {/* ── 顶部：日期 + 发布状态 ── */}
      <div className="flex items-center gap-4 mb-5">
        <input type="date" value={date} onChange={e => setDate(e.target.value)}
          className="h-9 px-3 rounded-lg bg-ur-card border border-ur-border text-sm text-white outline-none [color-scheme:dark] focus:border-ur-accent/50" />
        {briefing?.published === 1
          ? <span className="px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-semibold">✓ 已发布</span>
          : briefing
            ? <span className="px-3 py-1 rounded-full bg-yellow-500/15 border border-yellow-500/30 text-yellow-400 text-xs font-semibold">草稿</span>
            : <span className="text-xs text-gray-600">该日期暂无简报</span>
        }
      </div>

      {/* ── 基本信息行 ── */}
      <div className="data-card mb-4">
        {/* 第一行：日期 | 对手 | VRS排名 | 我方选图 | 对方选图 */}
        <div className="grid grid-cols-2 md:grid-cols-5 gap-x-5 gap-y-3 mb-4 pb-4 border-b border-ur-border">
          <div>
            <label className="text-[10px] text-gray-500 uppercase tracking-widest block mb-1">日期</label>
            <div className="text-white font-sans font-semibold text-sm pb-0.5">{date}</div>
          </div>
          <div>
            <label className="text-[10px] text-gray-500 uppercase tracking-widest block mb-1">对手</label>
            <input value={form.opponent} onChange={e => setForm({...form, opponent: e.target.value})}
              placeholder="对手队名"
              className="w-full bg-transparent border-b border-ur-border text-white text-sm outline-none focus:border-ur-accent/60 pb-0.5" />
          </div>
          <div>
            <label className="text-[10px] text-gray-500 uppercase tracking-widest block mb-1">VRS ASIA 排名</label>
            <input value={form.vrs_rank} onChange={e => setForm({...form, vrs_rank: e.target.value})}
              placeholder="# 排名"
              className="w-full bg-transparent border-b border-ur-border text-white text-sm outline-none focus:border-ur-accent/60 pb-0.5" />
          </div>
          <div>
            <label className="text-[10px] text-gray-500 uppercase tracking-widest block mb-1">我方选图 (M1)</label>
            <select value={form.map1_name} onChange={e => setForm({...form, map1_name: e.target.value})}
              className="w-full bg-transparent border-b border-ur-border text-white text-sm outline-none focus:border-ur-accent/60 pb-0.5">
              <option value="">选择地图</option>
              {MAP_OPTIONS.map(m => <option key={m.abbr} value={m.name}>{m.name}</option>)}
            </select>
          </div>
          <div>
            <label className="text-[10px] text-gray-500 uppercase tracking-widest block mb-1">对方选图 (M2)</label>
            <select value={form.map2_name} onChange={e => setForm({...form, map2_name: e.target.value})}
              className="w-full bg-transparent border-b border-ur-border text-white text-sm outline-none focus:border-ur-accent/60 pb-0.5">
              <option value="">选择地图</option>
              {MAP_OPTIONS.map(m => <option key={m.abbr} value={m.name}>{m.name}</option>)}
            </select>
          </div>
        </div>

        {/* 第二行：教练备注 · 重点训练内容 */}
        <div>
          <label className="text-[10px] text-gray-500 uppercase tracking-widest block mb-1">教练备注 · 重点训练内容</label>
          <input value={form.notes} onChange={e => setForm({...form, notes: e.target.value})}
            placeholder="本场重点训练方向..."
            className="w-full bg-transparent border-b border-ur-border text-white text-sm outline-none focus:border-ur-accent/60 pb-0.5" />
        </div>
      </div>

      {/* ── 两张图的战术要求 ── */}
      <div className="grid grid-cols-1 xl:grid-cols-2 gap-4 mb-4">
        {SLOTS.map(({ slot, label, mapKey }) => {
          const mapName = form[mapKey];
          const mapAbbr = MAP_ABBR_MAP[(mapName||'').toLowerCase()] || '';
          const mapColor = MAP_COLORS[mapAbbr] || '#8494a8';
          const activeRt = activeRound[slot];

          return (
            <div key={slot} className="data-card">
              {/* 图标题 */}
              <div className="flex items-center gap-3 mb-4">
                <div className="w-1.5 h-6 rounded" style={{ background: mapColor }} />
                <div>
                  <div className="font-sans font-semibold font-bold text-white text-base">{label}</div>
                  {mapName
                    ? <div className="text-sm font-semibold mt-0.5" style={{ color: mapColor }}>{mapName}</div>
