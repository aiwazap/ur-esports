  const [detailModal, setDetailModal] = useState(null);
  const [players,     setPlayers]     = useState([]);

  useEffect(() => {
    api.get('/players').then(r => setPlayers((r.data || []).filter(p => p.team_type === 'roster'))).catch(() => {});
  }, []);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const params = new URLSearchParams();
      if (filterMap)   params.set('map', filterMap);
      if (filterSide)  params.set('side', filterSide);
      if (filterRound) params.set('round_type', filterRound);
      const { data } = await api.get(`/training-plans/tactics?${params}`);
      setTactics(data);
    } catch {}
    setLoading(false);
  }, [filterMap, filterSide, filterRound]);

  useEffect(() => { load(); }, [load]);

  const handleInit = async () => {
    if (!confirm('将从预设数据初始化121条战术，确认吗？')) return;
    try {
      const resp = await fetch('/tactics_seed.json');
      const seed = await resp.json();
      const token = localStorage.getItem('token');
      const res = await fetch('/api/training-plans/tactics/batch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ tactics: seed }),
      });
      const result = await res.json();
      alert(`初始化完成：${result.inserted} 条已导入`);
      load();
    } catch(e) { alert('初始化失败: ' + e.message); }
  };

  const filtered = tactics.filter(t =>
    !search || t.name.includes(search) || t.tactic_id.includes(search) || (t.alias||'').includes(search)
  );

  const grouped = {};
  for (const t of filtered) {
    if (!grouped[t.map_abbr]) grouped[t.map_abbr] = [];
    grouped[t.map_abbr].push(t);
  }

  return (
    <div>
      {/* 工具栏 */}
      <div className="flex flex-wrap items-center gap-3 mb-5">
        <input value={search} onChange={e => setSearch(e.target.value)} placeholder="搜索战术名/编号..."
          className="h-9 px-3 rounded-lg bg-ur-card border border-ur-border text-sm text-white placeholder:text-gray-600 focus:border-ur-accent/50 outline-none w-48" />
        <select value={filterMap} onChange={e => setFilterMap(e.target.value)}
          className="h-9 px-3 rounded-lg bg-ur-card border border-ur-border text-sm text-white outline-none">
          <option value="">全部地图</option>
          {MAP_OPTIONS.map(m => <option key={m.abbr} value={m.abbr}>{m.name}</option>)}
        </select>
        <select value={filterSide} onChange={e => setFilterSide(e.target.value)}
          className="h-9 px-3 rounded-lg bg-ur-card border border-ur-border text-sm text-white outline-none">
          <option value="">T / CT</option>
          <option value="T">T</option>
          <option value="CT">CT</option>
        </select>
        <select value={filterRound} onChange={e => setFilterRound(e.target.value)}
          className="h-9 px-3 rounded-lg bg-ur-card border border-ur-border text-sm text-white outline-none">
          <option value="">全部局型</option>
          {ROUND_OPTIONS.map(r => <option key={r.code} value={r.code}>{r.label}</option>)}
        </select>
        <span className="text-sm text-gray-500 ml-auto">{filtered.length} 条战术</span>
        {canEdit && (
          <button onClick={() => setEditModal('new')}
            className="h-9 px-4 rounded-lg bg-ur-accent/15 border border-ur-accent/30 text-ur-accent text-sm font-semibold hover:bg-ur-accent/25 transition-colors">
            + 新增
          </button>
        )}
      </div>

      {/* 空状态 */}
      {!loading && tactics.length === 0 && (
        <div className="data-card text-center py-16">
          <div className="text-5xl mb-4 opacity-30">📋</div>
          <p className="text-gray-400 mb-2">战术总表为空</p>
          <p className="text-gray-600 text-sm mb-6">点击下方按钮导入预设的121条战术数据</p>
          {canEdit && (
            <button onClick={handleInit}
              className="px-6 py-2.5 rounded-lg bg-ur-accent/15 border border-ur-accent/30 text-ur-accent text-sm font-semibold hover:bg-ur-accent/25 transition-colors">
              从预设数据初始化（121条）
            </button>
          )}
        </div>
      )}

      {/* 战术列表 */}
      {Object.entries(grouped).map(([mapAbbr, mapTactics]) => (
        <div key={mapAbbr} className="data-card mb-4">
          <div className="flex items-center gap-3 mb-4">
            <div className="w-2 h-6 rounded" style={{ background: MAP_COLORS[mapAbbr] || '#666' }} />
            <h3 className="font-sans font-semibold font-bold text-lg" style={{ color: MAP_COLORS[mapAbbr] }}>
              {MAP_NAME_MAP[mapAbbr] || mapAbbr}
            </h3>
            <span className="text-xs text-gray-600 font-mono">{mapTactics.length} 条</span>
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="text-gray-500 border-b border-ur-border text-xs">
                  <th className="text-left py-2 pr-4 font-medium w-32">战术编号</th>
                  <th className="text-left py-2 pr-4 font-medium w-14">阵营</th>
                  <th className="text-left py-2 pr-4 font-medium w-20">局型</th>
                  <th className="text-left py-2 pr-4 font-medium">战术名称</th>
                  <th className="text-left py-2 pr-4 font-medium w-24">目标区域</th>
                  <th className="text-left py-2 font-medium">备注</th>
                  {canEdit && <th className="w-12" />}
                </tr>
              </thead>
              <tbody>
                {mapTactics.map(t => (
                  <tr key={t.tactic_id} onClick={() => setDetailModal(t)} className="border-b border-white/[0.04] hover:bg-white/[0.02] transition-colors group cursor-pointer">
                    <td className="py-2.5 pr-4">
                      <span className="font-mono text-xs text-ur-accent font-semibold">{t.tactic_id}</span>
                    </td>
                    <td className="py-2.5 pr-4">
                      <span className={`inline-flex px-2 py-0.5 rounded text-[11px] font-bold border ${SIDE_COLORS[t.team_side]?.text} ${SIDE_COLORS[t.team_side]?.bg} ${SIDE_COLORS[t.team_side]?.border}`}>
                        {t.team_side}
                      </span>
                    </td>
                    <td className="py-2.5 pr-4">
                      <span className={`inline-flex px-2 py-0.5 rounded text-[11px] font-bold border ${ROUND_COLORS[t.round_type]?.text} ${ROUND_COLORS[t.round_type]?.bg} ${ROUND_COLORS[t.round_type]?.border}`}>
                        {ROUND_OPTIONS.find(r => r.code === t.round_type)?.label || t.round_type}
                      </span>
                    </td>
                    <td className="py-2.5 pr-4 font-semibold text-white">{t.name}</td>
                    <td className="py-2.5 pr-4 text-gray-400 text-xs">{t.target_area}</td>
                    <td className="py-2.5 text-gray-500 text-xs">{t.notes}</td>
                    {canEdit && (
                      <td className="py-2.5 text-right">
                        <button onClick={(e) => { e.stopPropagation(); setEditModal(t); }}
                          className="opacity-0 group-hover:opacity-100 text-xs text-gray-500 hover:text-ur-accent transition-all px-2 py-1 rounded">
                          编辑
                        </button>
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      {detailModal && (
        <TacticDetailModal tactic={detailModal} players={players} canEdit={canEdit}
          onClose={() => setDetailModal(null)}
          onEdit={() => { const t = detailModal; setDetailModal(null); setEditModal(t); }} />
      )}
      {editModal && (
        <TacticEditModal tactic={editModal==='new'?null:editModal} players={players} onClose={()=>setEditModal(null)} onSaved={()=>{setEditModal(null);load();}} />
      )}
    </div>
  );
}

// ════════════════════════════════════════════════════════════
// 战术详情弹窗（点击战术行弹出，干净排版展示整套战术 + 队员职责）
// ════════════════════════════════════════════════════════════
function TacticDetailModal({ tactic, players, canEdit, onClose, onEdit }) {
  const t = tactic;
  let duties = [];
  try { duties = t.player_duties ? JSON.parse(t.player_duties) : []; } catch {}
  let steps = [];
  try { steps = t.steps ? JSON.parse(t.steps) : []; } catch {}
  const roundLabel = ROUND_OPTIONS.find(r => r.code === t.round_type)?.label || t.round_type;
  const Field = ({ label, children }) => (
    <div>
      <div className="text-[11px] text-gray-500 mb-1">{label}</div>
      <div className="text-sm text-white">{children || <span className="text-gray-600">—</span>}</div>
    </div>
  );
  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" onClick={onClose}>
      <div className="bg-ur-bg border border-ur-border rounded-lg w-full max-w-2xl max-h-[88vh] overflow-y-auto" onClick={e=>e.stopPropagation()}>
        <div className="flex items-center justify-between px-6 py-4 border-b border-ur-border sticky top-0 bg-ur-bg z-10">
          <div className="flex items-center gap-3">
            <span className={`inline-flex px-2 py-0.5 rounded text-[11px] font-bold border ${SIDE_COLORS[t.team_side]?.text} ${SIDE_COLORS[t.team_side]?.bg} ${SIDE_COLORS[t.team_side]?.border}`}>{t.team_side}</span>
            <h3 className="text-lg font-bold text-white">{t.name}</h3>
          </div>
          <div className="flex items-center gap-2">
            {canEdit && <button onClick={onEdit} className="text-xs px-3 py-1.5 rounded bg-ur-accent/15 border border-ur-accent/30 text-ur-accent hover:bg-ur-accent/25 transition-colors">编辑</button>}
            <button onClick={onClose} className="text-gray-500 hover:text-white text-2xl leading-none px-1">×</button>
          </div>
        </div>
        <div className="p-6 space-y-5">
          <div className="grid grid-cols-3 gap-4">
            <Field label="战术编号"><span className="font-mono text-ur-accent">{t.tactic_id}</span></Field>
            <Field label="地图">{MAP_NAME_MAP[t.map_abbr] || t.map_name}</Field>
            <Field label="局型">{roundLabel}</Field>
            <Field label="阵营">{t.team_side}</Field>
            <Field label="目标区域">{t.target_area}</Field>
            <Field label="别名">{t.alias}</Field>
          </div>
          <Field label="详细描述 / 备注"><span className="whitespace-pre-wrap leading-relaxed text-gray-200">{t.notes}</span></Field>
          {steps.length > 0 && (
            <div>
              <div className="text-[11px] text-gray-500 mb-2">战术步骤</div>
              <ol className="space-y-1.5">
                {steps.map((s, i) => (
                  <li key={i} className="flex gap-2 text-sm text-gray-200">
                    <span className="flex-none w-5 h-5 rounded bg-ur-accent/15 text-ur-accent text-[11px] font-bold flex items-center justify-center">{i+1}</span>
                    <span className="whitespace-pre-wrap">{s}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}
          <div>
            <div className="text-[11px] text-gray-500 mb-2">队员职责</div>
            {duties.length > 0 ? (
              <div className="space-y-2">
                {duties.map((d, i) => (
                  <div key={i} className="flex items-start gap-3 bg-ur-card/50 border border-ur-border rounded-lg px-3 py-2">
                    <span className="flex-none inline-flex px-2 py-0.5 rounded text-[11px] font-bold bg-ur-accent/15 text-ur-accent border border-ur-accent/30 min-w-[68px] justify-center">{d.player || '—'}</span>
                    <span className="text-sm text-gray-200 whitespace-pre-wrap leading-relaxed pt-0.5">{d.duty || '—'}</span>
                  </div>
                ))}
              </div>
            ) : <div className="text-sm text-gray-600">未设置队员职责{canEdit ? '，点击右上"编辑"添加' : ''}</div>}
          </div>
        </div>
      </div>
    </div>
  );
}

function TacticEditModal({ tactic, players = [], onClose, onSaved }) {
  const isNew = !tactic;
  const [form, setForm] = useState({
    map_abbr:    tactic?.map_abbr    || 'MRG',
    team_side:   tactic?.team_side   || 'T',
    round_type:  tactic?.round_type  || 'F',
    name:        tactic?.name        || '',
    target_area: tactic?.target_area || '',
    notes:       tactic?.notes       || '',
    alias:       tactic?.alias       || '',
  });
  const [saving, setSaving] = useState(false);
  const [duties, setDuties] = useState(() => {
    try { return tactic?.player_duties ? JSON.parse(tactic.player_duties) : []; } catch { return []; }
  });
  const addDuty = () => setDuties(d => [...d, { player: (players[0]?.nickname) || '', duty: '' }]);
  const setDuty = (i, k, v) => setDuties(d => d.map((x, j) => j === i ? { ...x, [k]: v } : x));
  const delDuty = (i) => setDuties(d => d.filter((_, j) => j !== i));
  const cleanDuties = () => duties.map(x => ({ player: String(x.player||'').trim(), duty: String(x.duty||'').trim() })).filter(x => x.player || x.duty);

  const save = async () => {
    if (!form.name) return alert('请填写战术名称');
    setSaving(true);
    try {
      let tid = tactic?.tactic_id;
      if (isNew) {
        const r = await api.post('/training-plans/tactics', { ...form, map_name: MAP_NAME_MAP[form.map_abbr]||form.map_abbr });
        tid = r.data?.tactic_id || tid;
      } else {
        await api.put(`/training-plans/tactics/${tactic.tactic_id}`, form);
      }
      if (tid) await api.put(`/training-plans/tactics/${tid}/duties`, { player_duties: cleanDuties() });
      onSaved();
    } catch(e) { alert('保存失败: ' + (e.response?.data?.error || e.message)); }
    setSaving(false);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60" onClick={onClose}>
      <div className="bg-ur-bg border border-ur-border rounded-lg w-full max-w-lg p-6" onClick={e=>e.stopPropagation()}>
        <h3 className="font-sans font-semibold text-xl font-bold text-white mb-5">{isNew ? '新增战术' : `编辑 ${tactic.tactic_id}`}</h3>
        <div className="grid grid-cols-3 gap-3 mb-3">
          {[
            { label:'地图', field:'map_abbr', opts: MAP_OPTIONS.map(m=>({value:m.abbr,label:m.name})) },
            { label:'阵营', field:'team_side', opts: [{value:'T',label:'T'},{value:'CT',label:'CT'}] },
            { label:'局型', field:'round_type', opts: ROUND_OPTIONS.map(r=>({value:r.code,label:r.label})) },
          ].map(({label,field,opts}) => (
            <div key={field}>
              <label className="text-xs text-gray-500 block mb-1">{label}</label>
              <select value={form[field]} onChange={e=>setForm({...form,[field]:e.target.value})} disabled={!isNew}
                className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none disabled:opacity-50">
                {opts.map(o=><option key={o.value} value={o.value}>{o.label}</option>)}
              </select>
            </div>
          ))}
        </div>
        <div className="space-y-3">
          <div>
            <label className="text-xs text-gray-500 block mb-1">战术名称 *</label>
            <input value={form.name} onChange={e=>setForm({...form,name:e.target.value})}
              className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none focus:border-ur-accent/50" />
          </div>
          <div className="grid grid-cols-2 gap-3">
            <div>
              <label className="text-xs text-gray-500 block mb-1">目标区域</label>
              <input value={form.target_area} onChange={e=>setForm({...form,target_area:e.target.value})} placeholder="爆A / 夹B..."
                className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none focus:border-ur-accent/50" />
            </div>
            <div>
              <label className="text-xs text-gray-500 block mb-1">别名</label>
              <input value={form.alias} onChange={e=>setForm({...form,alias:e.target.value})} placeholder="FLC / 猎鹰..."
                className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none focus:border-ur-accent/50" />
            </div>
          </div>
          <div>
            <label className="text-xs text-gray-500 block mb-1">备注</label>
            <textarea value={form.notes} onChange={e=>setForm({...form,notes:e.target.value})} rows={2}
              className="w-full bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none focus:border-ur-accent/50 resize-none" />
          </div>
          <div>
            <div className="flex items-center justify-between mb-1">
              <label className="text-xs text-gray-500">队员职责</label>
              <button type="button" onClick={addDuty}
                className="text-xs text-ur-accent hover:text-white border border-ur-accent/30 hover:border-ur-accent/60 rounded px-2 py-0.5 transition-colors">+ 增加</button>
            </div>
            {duties.length === 0 && <div className="text-xs text-gray-600 py-1">暂无，点击"+ 增加"为每名队员分配职责</div>}
            <div className="space-y-2">
              {duties.map((d, i) => (
                <div key={i} className="flex items-start gap-2">
                  <select value={d.player} onChange={e=>setDuty(i,'player',e.target.value)}
                    className="flex-none w-28 bg-ur-card border border-ur-border rounded-lg px-2 py-2 text-sm text-white outline-none focus:border-ur-accent/50">
                    <option value="">选择队员</option>
                    {players.map(p => <option key={p.id||p.nickname} value={p.nickname}>{p.nickname}</option>)}
                    {d.player && !players.some(p => p.nickname === d.player) && <option value={d.player}>{d.player}</option>}
                  </select>
                  <textarea value={d.duty} onChange={e=>setDuty(i,'duty',e.target.value)} rows={1} placeholder="该队员在此战术中的职责…"
                    className="flex-1 bg-ur-card border border-ur-border rounded-lg px-3 py-2 text-sm text-white outline-none focus:border-ur-accent/50 resize-y" style={{minHeight:38}} />
                  <button type="button" onClick={()=>delDuty(i)}
                    className="flex-none text-gray-600 hover:text-ur-rose text-lg leading-none px-1.5 py-1.5">×</button>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div className="flex justify-end gap-3 mt-5">
          <button onClick={onClose} className="text-sm text-gray-400 hover:text-white px-4 py-2">取消</button>
          <button onClick={save} disabled={saving}
            className="px-5 py-2 rounded-lg bg-ur-accent/15 border border-ur-accent/30 text-ur-accent text-sm font-semibold hover:bg-ur-accent/25 disabled:opacity-50 transition-colors">
            {saving ? '保存中...' : '保存'}
          </button>
        </div>
      </div>
    </div>
  );
}


