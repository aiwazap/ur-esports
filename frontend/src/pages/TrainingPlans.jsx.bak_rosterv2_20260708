// ── 犯错类型模糊匹配 ────────────────────────────────
function fuzzyMatchError(text, errorTypes) {
  if (!text || !text.trim() || !errorTypes.length) return null;
  const t = text.toLowerCase();
  let best = null, bestScore = 0;
  for (const et of errorTypes) {
    if (!et.is_active) continue;
    let score = 0;
    // 1. 关键词命中(权重最高)
    const kws = (et.keywords || '').split(',').map(k => k.trim().toLowerCase()).filter(Boolean);
    for (const kw of kws) {
      if (kw && t.includes(kw)) score += 10 + kw.length;
    }
    // 2. 名称子串匹配
    const nameLow = et.name.toLowerCase();
    if (t.includes(nameLow)) score += 20;
    else {
      // 名称中的每个关键片段(去掉括号内容)
      const cleanName = nameLow.replace(/\(.*?\)/g, '').replace(/（.*?）/g, '');
      const parts = cleanName.split(/[\/,、\s]+/).filter(p => p.length >= 2);
      for (const p of parts) { if (t.includes(p)) score += 6 + p.length; }
    }
    // 3. 分类名命中(低权重加分)
    if (et.category && t.includes(et.category.toLowerCase())) score += 3;
    if (score > bestScore) { bestScore = score; best = et; }
  }
  return bestScore >= 6 ? best : null; // 阈值:至少命中一个2字关键词
}

